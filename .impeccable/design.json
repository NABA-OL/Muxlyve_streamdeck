      "kind": "custom",
      "refersTo": "property-inspector-panel",
      "description": "Panel HTML embebido en la app de Stream Deck para configurar plataforma, host y puerto.",
      "html": "<div class=\"ds-pi\"><h3 class=\"ds-pi-title\">Muxlyve</h3><label class=\"ds-pi-label\" for=\"platform\">Plataforma</label><select class=\"ds-pi-select\" id=\"platform\"><option value=\"twitch\">Twitch</option><option value=\"youtube\">YouTube</option><option value=\"kick\">Kick</option><option value=\"tiktok\">TikTok</option></select><label class=\"ds-pi-label\" for=\"panelHost\">Host del panel</label><input class=\"ds-pi-input\" id=\"panelHost\" type=\"text\" placeholder=\"127.0.0.1\" /><span class=\"ds-pi-hint\">IP o hostname de la máquina que corre Muxlyve.</span><label class=\"ds-pi-label\" for=\"panelPort\">Puerto del panel</label><input class=\"ds-pi-input\" id=\"panelPort\" type=\"number\" value=\"19080\" min=\"1\" max=\"65535\" /><span class=\"ds-pi-hint\">Puerto de la API local de Muxlyve.</span></div>",
      "css": ".ds-pi{font-family:system-ui,-apple-system,sans-serif;background:#0d1117;padding:12px;color:#e6edf3;}.ds-pi-title{margin:0 0 8px;font-size:13px;font-weight:600;color:#7c5cff;}.ds-pi-label{display:block;margin-top:8px;font-size:12px;color:#8b949e;}.ds-pi-select,.ds-pi-input{width:100%;box-sizing:border-box;margin-top:4px;padding:6px;background:#161b22;border:1px solid #2a3140;color:#e6edf3;border-radius:6px;font-size:12px;}.ds-pi-hint{display:block;font-size:11px;color:#8b949e;margin-top:6px;}"
    }
