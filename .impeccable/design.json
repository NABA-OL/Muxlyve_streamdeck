  "narrative": {
    "northStar": "The Streamer's Edge",
    "overview": "Muxlyve Stream Deck plugin es la herramienta del streamer que va en serio. Oscura, directa, sin concesiones. Cada botón comunica estado en un vistazo — el streamer no lee, reconoce. La interfaz es honrada: plana, sin sombras falsas, sin decoración que no aporte información de estado. El sistema visual se despliega en tres superficies: los iconos de botón (72×72 PNG), el property inspector (panel HTML), y los assets de Marketplace.",
    "keyCharacteristics": [
      "Plano y honesto. Sin sombras, sin glassmorphism, sin gradientes decorativos.",
      "Estado sobre estilo. Cada variante visual comunica estado (live/connecting/error/offline).",
      "Oscuro por diseño. Fondo #0d1117, superficies #161b22.",
      "Firma morada. El acento #7c5cff es la señal Muxlyve."
    ],
    "rules": [
      { "name": "The Flat-By-Default Rule", "body": "Las superficies son planas en reposo. No hay sombras de hover, no hay elevación. Un borde de 1px (#2a3140) separa los campos del fondo. Esa es la única demarcación.", "section": "elevation" },
      { "name": "The Platform-Color Rule", "body": "Los colores de plataforma son fijos e innegociables. No modificarlos para 'armonizar'. Su reconocibilidad es más importante que la cohesión de paleta.", "section": "colors" }
    ],
    "dos": [
      "Usar brand-bg (#0d1117) como fondo base del property inspector y assets de Marketplace.",
      "Usar brand-accent (#7c5cff) exclusivamente para elementos Muxlyve.",
      "Mantener los colores de plataforma exactos (Twitch Purple #9147ff, YouTube Red #ff0000, Kick Green #53fc18, TikTok Black #010101).",
      "Usar los 7 estados visuales para cubrir toda la grilla de condición.",
      "Comunicar estado con al menos dos señales simultáneas para accesibilidad.",
      "Generar los PNG a 72×72 y 144×144 (@2x) para cubrir dispositivos SD de distintas densidades."
