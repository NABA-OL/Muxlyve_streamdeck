{
    "Name": "Muxlyve",
    "UUID": "com.blackraken.muxlyve.streamdeck",
    "Version": "2.2.2.0",
    "Author": "BlacKraken Solutions",
    "URL": "https://muxlyve.com",
    "Description": "Controla tus retransmisiones de Muxlyve desde el Stream Deck: enciende o apaga Twitch, YouTube, Kick y TikTok con un botón.",
    "Category": "Muxlyve",
    "CategoryIcon": "imgs/plugin/categoryIcon",
    "Icon": "imgs/plugin/icon",
    "CodePath": "bin/plugin.js",
    "PropertyInspectorPath": "ui/property-inspector.html",
    "SDKVersion": 3,
    "Nodejs": {
        "Version": "20"
    },
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "10.15"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Actions": [
        {
            "Name": "Twitch",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.twitch",
            "Icon": "imgs/actions/twitch/icon",
            "Tooltip": "Toggle Twitch",
            "PropertyInspectorPath": "ui/property-inspector.html",
            "States": [
                {
                    "Image": "imgs/actions/twitch/off"
                }
            ]
        },
        {
            "Name": "YouTube",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.youtube",
            "Icon": "imgs/actions/youtube/icon",
            "Tooltip": "Toggle YouTube",
            "PropertyInspectorPath": "ui/property-inspector.html",
            "States": [
                {
                    "Image": "imgs/actions/youtube/off"
                }
            ]
        },
        {
            "Name": "Kick",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.kick",
            "Icon": "imgs/actions/kick/icon",
            "Tooltip": "Toggle Kick",
            "PropertyInspectorPath": "ui/property-inspector.html",
            "States": [
                {
                    "Image": "imgs/actions/kick/off"
                }
            ]
        },
        {
            "Name": "TikTok",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.tiktok",
            "Icon": "imgs/actions/tiktok/icon",
            "Tooltip": "Toggle TikTok",
            "PropertyInspectorPath": "ui/property-inspector.html",
            "States": [
                {
                    "Image": "imgs/actions/tiktok/off"
                }
            ]
        },
        {
            "Name": "Starvios",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.starvios",
            "Icon": "imgs/actions/starvios/icon",
            "Tooltip": "Toggle Starvios",
            "PropertyInspectorPath": "ui/property-inspector.html",
            "States": [
                {
                    "Image": "imgs/actions/starvios/off"
                }
            ]
        },
        {
            "Name": "Buffer",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.buffer",
            "Icon": "imgs/actions/buffer/icon",
            "Tooltip": "Activar/desactivar buffer de grabación",
            "PropertyInspectorPath": "ui/property-inspector-buffer.html",
            "States": [
                {
                    "Image": "imgs/actions/buffer/on"
                }
            ]
        },
        {
            "Name": "Guardar clip",
            "UUID": "com.blackraken.muxlyve.streamdeck.save.clip",
            "Icon": "imgs/actions/clip/icon",
            "Tooltip": "Guardar clip del buffer",
            "PropertyInspectorPath": "ui/property-inspector-clip.html",
            "States": [
                {
                    "Image": "imgs/actions/clip/idle"
                }
            ]
        },
        {
            "Name": "Grabación completa",
            "UUID": "com.blackraken.muxlyve.streamdeck.toggle.fullrecord",
            "Icon": "imgs/actions/fullrecord/icon",
            "Tooltip": "Activar/desactivar grabación completa",
            "PropertyInspectorPath": "ui/property-inspector-fullrecord.html",
            "States": [
                {
                    "Image": "imgs/actions/fullrecord/off"
                }
            ]
        },
        {
            "Name": "Perfil",
            "UUID": "com.blackraken.muxlyve.streamdeck.preset",
            "Icon": "imgs/actions/preset/icon",
            "Tooltip": "Activar/desactivar un perfil de destinos",
            "PropertyInspectorPath": "ui/property-inspector-preset.html",
            "States": [
                {
                    "Image": "imgs/actions/preset/unassigned"
                }
            ]
        }
    ]
}